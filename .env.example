# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# - Copy `.env.example` to `.env` for local configuration:
#     copy .env.example .env   (Windows)
#     cp .env.example .env     (Linux/macOS)
# - Never commit the actual `.env` file to version control (it is ignored in .gitignore).
# - API credentials belong ONLY in environment variables or your untracked local .env file.
# - Do not commit real keys or secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration (V2: Groq Sole Active Provider)
# ------------------------------------------------------------------------------
# Provider identifier: "groq" (default for V2 runtime) or "mock" (offline testing)
LLM_PROVIDER=groq

# Groq API Key (never commit or share; obtain from https://console.groq.com)
GROQ_API_KEY=
# Legacy alias also supported if GROQ_API_KEY is not set:
# LLM_API_KEY=

# Groq Model identifier (default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b
# Legacy alias also supported:
# LLM_MODEL=openai/gpt-oss-20b

# Operational settings
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0

# ------------------------------------------------------------------------------
# Evidence Retrieval Configuration (Step 13)
# ------------------------------------------------------------------------------
# Retrieval backend: "sentence_transformer" (default) or "tfidf_lexical"
EVIDENCE_BACKEND=sentence_transformer

# Semantic similarity threshold [0.0, 1.0] (engineering default, uncalibrated on test set)
EVIDENCE_SIMILARITY_THRESHOLD=0.45

# Default top-k retrieved evidence items per claim
EVIDENCE_TOP_K=3

# ------------------------------------------------------------------------------
# Live Evidence Discovery Configuration (V2.2: GDELT News Discovery)
# ------------------------------------------------------------------------------
# Toggle live web-based news discovery (default: true)
LIVE_EVIDENCE_ENABLED=true

# Public GDELT 2.0 endpoints (NO API KEY REQUIRED)
GDELT_CONTEXT_URL=https://api.gdeltproject.org/api/v2/context/context
GDELT_DOC_URL=https://api.gdeltproject.org/api/v2/doc/doc

# Discovery parameters
GDELT_TIMEOUT_SECONDS=10
GDELT_MAX_RECORDS=25
LIVE_EVIDENCE_TOP_K=5
GDELT_CONTEXT_TIMESPAN=72h
GDELT_DOC_FALLBACK=true
GDELT_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# Persistence / Database Configuration (Step 16)
# ------------------------------------------------------------------------------
# SQLite database path (relative to repository root or absolute)
DATABASE_PATH=data/app/fake_news_analysis.db

# ------------------------------------------------------------------------------
# Frontend / API Client Configuration (Step 18)
# ------------------------------------------------------------------------------
# Base URL of the FastAPI backend server
API_BASE_URL=http://127.0.0.1:8000

