# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# - Copy `.env.example` to `.env` for local configuration:
#     copy .env.example .env   (Windows)
#     cp .env.example .env     (Linux/macOS)
# - Never commit the actual `.env` file to version control (it is ignored in .gitignore).
# - API credentials belong ONLY in environment variables or your untracked local .env file.
# - Do not commit real keys or secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provider identifier (e.g. "mock", "gemini", "openai", "anthropic")
LLM_PROVIDER=

# Secret API Key (never share or commit)
LLM_API_KEY=

# Model identifier (e.g. "mock-model-v1", "gemini-1.5-flash", "gpt-4o-mini")
LLM_MODEL=

# Operational settings
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0

# ------------------------------------------------------------------------------
# Evidence Retrieval Configuration (Step 13)
# ------------------------------------------------------------------------------
# Retrieval backend: "sentence_transformer" (default) or "tfidf_lexical"
EVIDENCE_BACKEND=sentence_transformer

# Semantic similarity threshold [0.0, 1.0] (engineering default, uncalibrated on test set)
EVIDENCE_SIMILARITY_THRESHOLD=0.45

# Default top-k retrieved evidence items per claim
EVIDENCE_TOP_K=3

# ------------------------------------------------------------------------------
# Persistence / Database Configuration (Step 16)
# ------------------------------------------------------------------------------
# SQLite database path (relative to repository root or absolute)
DATABASE_PATH=data/app/fake_news_analysis.db

# ------------------------------------------------------------------------------
# Frontend / API Client Configuration (Step 18)
# ------------------------------------------------------------------------------
# Base URL of the FastAPI backend server
API_BASE_URL=http://127.0.0.1:8000

